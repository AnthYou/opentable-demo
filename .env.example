# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The VITE_ prefix is not cosmetic: Vite compiles only VITE_-prefixed variables into the
# browser bundle. That is the mechanical guarantee the write key cannot leak client-side,
# and scripts/2-index.js refuses to run if a write key ever gains the prefix.
#
# On a deployment platform these go in the project's environment settings, not the repo.
# Vercel reads them from Project Settings.

# browser — public
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_INDEX_NAME=

# scripts only — NEVER prefixed with VITE_
ALGOLIA_WRITE_API_KEY=
